<style>
  /* Import a modern font, e.g., Roboto */
  @import url('https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap');

  .navbar-nav .nav-item {
      margin-right: 20px; /* Adjust this value to increase or decrease the gap */
  }
  .navbar-nav .nav-link {
      font-weight: 500; /* Increased font weight */
      color: rgba(0, 0, 0, .6);
      font-family: 'Roboto', sans-serif; /* Modern font */
  }
  .navbar-nav .nav-link:hover {
      color: #1c0030;
  }
  .navbar-nav .nav-item.active .nav-link {
      color: #1c0030; /* Text color for active link */
      font-weight: 700; /* Bold font weight for active link */
  }
  .navbar-nav .nav-item.active {
      border-radius: 5px; /* Optional: rounded corners for active link */
  }
  @media (max-width: 767.98px) {
      .navbar-nav {
          text-align: center;
      }
      .navbar-nav .nav-item {
          margin-right: 0;
          margin-bottom: 10px;
      }
  }
</style>

<nav class="navbar navbar-expand-lg navbar-light bg-transparent pt-3 pb-3">
  <a class="navbar-brand" href="#"><img src="/logo.png" alt="Logo" style="max-height: 60px;"></a>
  <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
  </button>
  <div class="collapse navbar-collapse justify-content-end" id="navbarNav">
      <ul class="navbar-nav" style="font-size: 18px;">
          <li class="nav-item">
              <a class="nav-link" href="/">Home <span class="sr-only">(current)</span></a>
          </li>
          <li class="nav-item">
              <a class="nav-link" href="/solutions">Solutions</a>
          </li>
          <li class="nav-item">
              <a class="nav-link" href="/vision">Vision</a>
          </li>
          <li class="nav-item">
              <a class="nav-link" href="/about">About Us</a>
          </li>
          <li class="nav-item">
              <a class="nav-link" href="/contact">Contact</a>
          </li>
      </ul>
  </div>
</nav>

<script>
  // Ensure the active class is added correctly on page load
  document.addEventListener('DOMContentLoaded', function () {
      var currentLocation = window.location.pathname;
      var navLinks = document.querySelectorAll('.nav-link');
      navLinks.forEach(function (link) {
          if (link.getAttribute('href') === currentLocation) {
              link.parentElement.classList.add('active');
          }
      });
  });
</script>