<style>
    .hero {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .hero-text {
        flex: 1;
        order: 1;
    }

    .hero-title {
        font-size: 2.5rem;
        color: #1c0030;
        font-weight: 500;
        margin-bottom: 25px;
        line-height: 1.2;
    }

    .hero-subtitle {
        font-size: 1rem;
        color: #1c0030;
        font-weight: 400;
        line-height: 1.6;
        margin-bottom: 25px;  
    }
    .hero-text button{
        padding: 0.5rem 1rem;
        background-color: #1c0030;
        color: white;
        border: none;
        border-radius: 25px;
        cursor: pointer;
        transition: background-color 0.3s;
        margin-top: 12px;
    }
    .hero-text button:hover {
        background-color: #350063; /* Change this to the color you want on hover */
    }

    .hero-image {
        flex: 1;
        order: 2;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .hero-image img {
        width: 92%;
        height: auto;
    }
    @media (max-width: 991px) {
        .hero {
            flex-direction: column;
            gap: 2rem;
        }
    }
    @media (max-width: 768px) {
    
    }
    @media (max-width: 576px) {
    
    }
</style>

<div class="hero pt-5 pb-5">
    <div class="hero-text">
        <h1 class="hero-title"> <%- heroTitle %> </h1>
        <p class="hero-subtitle"><%- heroSubtitle %></p>
        <script>
            (function () {
                var target = document.currentScript;
                window.addEventListener('load', function () {
                    calendar.schedulingButton.load({
                        url: 'https://calendar.google.com/calendar/appointments/schedules/AcZssZ0DDm4ePS2bsYZT4A3JLC6xVOFkuud4S8NqgkLX_9-Z1sTKqL_kdMogE-pUQkU2M2Un6m6XcqhJ?gv=true',
                        color: '#1c0030',
                        label: 'Book Now',
                        target,
                    });
                    // Apply text color after the button is loaded
                    setTimeout(function () {
                        var button = target.nextSibling;
                        if (button && button.tagName === 'BUTTON') {
                            button.style.color = '#ffffff';
                        }
                    }, 1000); // Adjust the timeout if needed to ensure the button is loaded
                });
            })();
        </script>
    </div>
    <div class="hero-image">
        <img src="/<%- heroImage %>" alt="Hero Image">
    </div>
    
</div>