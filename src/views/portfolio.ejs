        position: relative;
    }

    .portfolio-card-header h5 {
        font-size: 1.5rem;
        font-weight: 600;
        margin: 0;
    }

    .portfolio-card-header .icon {
        font-size: 2.5rem;
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        opacity: 0.2;
    }

    .portfolio-card-content {
        padding: 20px;
    }

    .portfolio-card-content p {
