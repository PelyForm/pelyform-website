<style>
    .portfolio-container {
        padding: 80px 20px;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .portfolio-heading-wrapper {
        text-align: center;
        margin-bottom: 50px;
    }

    .portfolio-heading-wrapper h1 {
        font-weight: 700;
        color: #1c0030;
        margin-bottom: 10px;
        font-size: 2.5rem;
    }

    .heading-underline {
        width: 100px;
        height: 5px;
        background-color: #53018b;
        border-radius: 25px;
        margin: 0 auto;
    }

    .portfolio-container p {
        color: #1c0030;
        font-size: 1.1rem;
        font-weight: 400;
        line-height: 1.8;
        text-align: center;
        margin-bottom: 50px;
        max-width: 800px;
    }

    .portfolio-card-container {
        display: flex;
        flex-wrap: wrap;
        gap: 40px;
        justify-content: center;
    }

    .portfolio-card {
        background-color: #fff;
        border-radius: 15px;
        box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1);
        overflow: hidden;
        width: 350px;
        transition: transform 0.3s, box-shadow 0.3s;
    }

    .portfolio-card:hover {
        transform: translateY(-10px);
        box-shadow: 0 15px 30px rgba(0, 0, 0, 0.2);
    }

    .portfolio-card-header {
        background: #d5d2f2;
        color: #53018b;
        padding: 20px;
