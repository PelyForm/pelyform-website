<div class="contact-container pt-5">
    <div class="contact-heading-wrapper">
        <h1>Contact Us</h1>
        <div class="heading-underline"></div>
    </div>
    <p>We're committed to delivering innovative solutions that elevate your business. Connect with us to explore how our expertise can drive your success.</p>
    <div class="contact-content mt-5">
        <div class="contact-link">
            <div class="contact-wrapper">
                <h2>Get in Touch</h2>
                <p>We're here to answer your questions and provide the support you need.</p>
                <div class="info">
                    <div><i class="fas fa-phone"></i> +880 01823614751</div>
                    <div><i class="fas fa-envelope"></i> tausif@pelyform.com</div>
                    <div><i class="fas fa-map-marker-alt"></i> Dhaka, Bangladesh</div>
                </div>
                <div class="social-icons">
                    <div class="social-icons-link">
                        <a href="https://www.fiverr.com/shekhahamid" target="_blank"><img src="/fiverr-logo.png" alt="Fiverr Profile"></a>
                    </div>
                </div>
            </div>
        </div>
        <div class="contact-booking">
            <div class="contact-booking-wrapper">
                <p>Our tailored solutions are designed to meet your unique business needs. Schedule a meeting with us to discuss how we can help you achieve your goals.</p>
                <!-- Google Calendar Appointment Scheduling begin -->
                <script>
                    (function () {
                        var target = document.currentScript;
                        window.addEventListener('load', function () {
                            calendar.schedulingButton.load({
                                url: 'https://calendar.google.com/calendar/appointments/schedules/AcZssZ0DDm4ePS2bsYZT4A3JLC6xVOFkuud4S8NqgkLX_9-Z1sTKqL_kdMogE-pUQkU2M2Un6m6XcqhJ?gv=true',
                                color: '#1c0030',
                                label: 'Book Now',
                                target,
                            });
                            setTimeout(function () {
                                var button = target.nextSibling;
                                if (button && button.tagName === 'BUTTON') {
                                    button.style.color = '#fff';
                                }
                            }, 1000);
                        });
                    })();
                </script>
            </div>
            <!-- end Google Calendar Appointment Scheduling -->

            <!-- start contact form  -->
            <div class="contact-form">
                <p >Or, use the form below to send us a message, and we'll get back to you shortly.</p>
                <br>
                <form action="/form-submit-success" method="POST">
                    <div class="form-group">
                        <label for="name">Name</label>
                        <input type="text" id="name" name="name" class="form-control" required>
                    </div>
                    <div class="form-group">
                        <label for="email">Email</label>
                        <input type="email" id="email" name="email" class="form-control" required>
                    </div>
                    <div class="form-group">
                        <label for="company">Company (Optional)</label>
                        <input type="text" id="company" name="company" class="form-control">
                    </div>
                    <div class="form-group">
                        <label for="message">Message</label>
                        <textarea name="message" id="message" class="form-control" required></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary gtm_send_message">Send Message</button>
                </form>
            </div>
            <!-- end contact form  -->
        </div>
    </div>
</div>
