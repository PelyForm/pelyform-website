        font-weight: 600;
    }

    .contact-wrapper p {
        font-size: 14px;
        color: #1c0030;
        text-align: left;
        font-weight: 400;
        padding-top: -3px;
    }

    .info {
        margin: 50px 0 10px 0;
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

