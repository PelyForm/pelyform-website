    .contact-heading-wrapper {
        width: 250px;
    }

    .contact-heading-wrapper h1 {
        font-weight: 600;
        color: #1c0030;
        padding-bottom: 5px;
    }

    .heading-underline {
        width: 100px;
        height: 5px;
        background-color: #53018b;
        border-radius: 25px;
        margin-bottom: 30px;
    }

    .contact-container p {
        color: #1c0030;
