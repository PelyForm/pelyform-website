        border: 1px solid #d1d0d2;
        border-radius: 5px;
    }

    .contact-form textarea {
        height: 150px;
    }

    .contact-form button {
        padding: 0.5rem 1rem;
        background-color: #1c0030;
        color: white;
        border: none;
