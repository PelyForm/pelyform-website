    <style>
        .gradient-section {
            background: linear-gradient(to bottom, #FBF4DF, rgba(104, 95, 212, 0.1));
            color: #000;
        }

        .navbar {
            padding-left: 0 !important;
            padding-right: 0 !important;
        }

        .card-container {
            display: flex;
            flex-wrap: wrap;
            gap: 20px;
        }

        .card-wrapper {
            background: transparent;
            border-radius: 25px;
            padding: 20px;
            flex: 1;
            border: 3px solid #ffffff;
            box-shadow: rgba(216, 215, 215, 0.1) -4px 9px 25px -6px;
            width: 100%;
        }

        .icon-container {
            width: 60px;
            height: 60px;
            border-radius: 50%;
            display: flex;
            justify-content: center;
            align-items: center;
            margin-bottom: 25px;
        }

        .card-icon {
            color: rgb(48, 47, 47);
            font-size: 25px;

        }

        .card-wrapper p {
            font-size: 1rem;
            font-weight: 400;
            color: rgba(0, 0, 0, .6);
            line-height: 1.6;
            margin-bottom: 0;
            padding-bottom: 0;
        }

        @media (max-width: 992px) {
            .card-container {
                flex-direction: column;
                align-items: center;
            }

            .card {
                max-width: 100%;
            }
        }
    </style>
